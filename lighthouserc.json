{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/library/",
        "http://localhost:4173/library/negroni/",
        "http://localhost:4173/design-system/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
